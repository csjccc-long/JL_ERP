<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.erp.mapper.ErpBusinessMapper">

    <select id="selectDeptScope" parameterType="Long" resultType="java.lang.Long">
        select dept_id from sys_dept where dept_id = #{deptId} or find_in_set(#{deptId}, ancestors)
    </select>

</mapper>
